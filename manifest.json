{
  "manifest_version": 3,
  "name": "I CANT FIND THE TEXT!",
  "version": "1.1",
  "description": "Turns the entire internet into a giant scrolling scavenger hunt.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html"
  }
}
